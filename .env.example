# Dijiy environment template.
# Copy to .env.local for local development. NEVER commit real values.
# In Vercel, set these per environment (Development / Preview / Production).

# --- Public (exposed to the browser; protected by RLS) -----------------------
# Supabase project: TURKSTILHOUSE-CORE (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://iqmmjhsrbtzkubgfjyra.supabase.co
# Publishable key (sb_publishable_...). Leave blank here; fill in .env.local.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical site URL (optional; e.g. https://dijiy.vercel.app)
NEXT_PUBLIC_SITE_URL=

# --- Server only (never prefix with NEXT_PUBLIC_) -----------------------------
# Secret key (sb_secret_...). Bypasses RLS. Only for trusted server jobs.
# Leave unset unless a feature explicitly needs it.
SUPABASE_SECRET_KEY=
# Dijiy tenant identifiers in CORE (public.organizations / public.projects).
DIJIY_ORGANIZATION_ID=
DIJIY_PROJECT_ID=
